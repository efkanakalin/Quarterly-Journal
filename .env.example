VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# --- hCaptcha (bot/credential-stuffing protection) ---
# 1) https://hcaptcha.com adresinden kayıt ol → site oluştur → site key + secret al
# 2) Buraya site key'i koy (public)
# 3) Supabase Dashboard → Authentication → Settings → Bot and abuse protection →
#    enable hCaptcha + secret key'i gir
# Bu env yoksa hCaptcha test key'i (her zaman pass) kullanılır — production'da TANIMLA.
VITE_HCAPTCHA_SITE_KEY=your-hcaptcha-site-key

# --- Brokers (Tradovate auto-sync) ---
# Required only if you want the Brokers page Tradovate connect/sync to work.
# The browser cannot call Tradovate directly (CORS), so all calls go through
# a Cloudflare Worker proxy whose code lives in cloudflare-worker/.
# Deploy the worker (see cloudflare-worker/README.md) and put its URL here.
# No OAuth app registration is needed — users paste their Tradovate API token
# directly in the Brokers UI.
VITE_TRADOVATE_WORKER_URL=https://your-worker-subdomain.workers.dev

# --- News panel ---
# Both keys are read by the edge functions, NOT the client.
# Finnhub — live economic data releases (free tier, 60 req/min):
#   supabase secrets set FINNHUB_API_KEY=your-finnhub-key
# (Legacy) FRED key — no longer used by default; kept for possible future fallback:
#   supabase secrets set FRED_API_KEY=your-fred-key
