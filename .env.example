VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# --- News panel ---
# Both keys are read by the edge functions, NOT the client.
# Finnhub — live economic data releases (free tier, 60 req/min):
#   supabase secrets set FINNHUB_API_KEY=your-finnhub-key
# (Legacy) FRED key — no longer used by default; kept for possible future fallback:
#   supabase secrets set FRED_API_KEY=your-fred-key
