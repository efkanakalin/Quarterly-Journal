VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# --- Brokers (Tradovate auto-sync) ---
# Required only if you want the Brokers page Tradovate connect/sync to work.
# The browser cannot call Tradovate directly (CORS), so all calls go through
# a Cloudflare Worker proxy whose code lives in cloudflare-worker/.
#
# 1. Register an OAuth app at Tradovate; set the redirect URI to
#    https://<your-app-host>/brokers/tradovate/callback
# 2. Deploy the worker (see cloudflare-worker/README.md) and copy its URL.
VITE_TRADOVATE_WORKER_URL=https://your-worker-subdomain.workers.dev
VITE_TRADOVATE_CLIENT_ID=your-tradovate-oauth-client-id

# --- News panel ---
# Both keys are read by the edge functions, NOT the client.
# Finnhub — live economic data releases (free tier, 60 req/min):
#   supabase secrets set FINNHUB_API_KEY=your-finnhub-key
# (Legacy) FRED key — no longer used by default; kept for possible future fallback:
#   supabase secrets set FRED_API_KEY=your-fred-key
